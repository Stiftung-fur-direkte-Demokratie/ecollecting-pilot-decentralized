{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/sections/**",
              "ui_kits/admin-website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Font-Regular|Font-Bold|Font-Italic|Font-Bold-Italic|Fallback-font))/i]",
        "message": "Font not provided by the design system. Available: Font-Regular, Font-Bold, Font-Italic, Font-Bold-Italic, Fallback-font."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItemSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|content|step|key|ref|className|style|children)$/]",
        "message": "<AccordionItemSpec> doesn't accept that prop. Declared props: id, title, content, step."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|color|size|icon|iconLeft|clickable|disabled|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, children, color, size, icon, iconLeft, clickable, disabled, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:gray|red|yellow|orange|green|blue|indigo|purple|pink|negative|info|error|warning|success)$/]",
        "message": "<Badge> color must be one of 'gray' | 'red' | 'yellow' | 'orange' | 'green' | 'blue' | 'indigo' | 'purple' | 'pink' | 'negative' | 'info' | 'error' | 'warning' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:base|sm)$/]",
        "message": "<Badge> size must be one of 'base' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|variant|size|icon|iconPos|href|disabled|fullWidth|type|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Btn> doesn't accept that prop. Declared props: label, children, variant, size, icon, iconPos, href, disabled, fullWidth, type, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|filled|bare|link|outline-negative|bare-negative|link-negative)$/]",
        "message": "<Btn> variant must be one of 'outline' | 'filled' | 'bare' | 'link' | 'outline-negative' | 'bare-negative' | 'link-negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|base|lg)$/]",
        "message": "<Btn> size must be one of 'sm' | 'base' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute[name.name='iconPos'] > Literal[value!=/^(?:left|right|only|none)$/]",
        "message": "<Btn> iconPos must be one of 'left' | 'right' | 'only' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Btn> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|layout|image|imageAlt|header|metaInfos|title|description|children|footerInfo|footerAction|href|className|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: type, layout, image, imageAlt, header, metaInfos, title, description, children, footerInfo, footerAction, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:default|flat|highlight|universal)$/]",
        "message": "<Card> type must be one of 'default' | 'flat' | 'highlight' | 'universal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:default|image-left|image-right)$/]",
        "message": "<Card> layout must be one of 'default' | 'image-left' | 'image-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|href|format|size|meta|icon|className|key|ref|className|style|children)$/]",
        "message": "<DownloadItem> doesn't accept that prop. Declared props: title, description, href, format, size, meta, icon, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|overtitle|title|subtitle|description|cta|image|imageAlt|meta|className|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: type, overtitle, title, subtitle, description, cta, image, imageAlt, meta, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:default|main|title-only|hub|overview)$/]",
        "message": "<Hero> type must be one of 'default' | 'main' | 'title-only' | 'hub' | 'overview'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|spin|title|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, spin, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|type|variant|size|placeholder|value|defaultValue|message|messageType|required|disabled|readOnly|hideLabel|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: id, label, type, variant, size, placeholder, value, defaultValue, message, messageType, required, disabled, readOnly, hideLabel, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|url|password|search|number|date|time|file|color|range)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'tel' | 'url' | 'password' | 'search' | 'number' | 'date' | 'time' | 'file' | 'color' | 'range'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|negative)$/]",
        "message": "<Input> variant must be one of 'outline' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|base|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'base' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='messageType'] > Literal[value!=/^(?:error|warning|success|info)$/]",
        "message": "<Input> messageType must be one of 'error' | 'warning' | 'success' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|acronym|href|src|className|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: title, acronym, href, src, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|children|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|children|text|icon|closeBtn|action|headingLevel|onClose|className|key|ref|className|style|children)$/]",
        "message": "<Notification> doesn't accept that prop. Declared props: type, title, children, text, icon, closeBtn, action, headingLevel, onClose, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:hint|info|success|warning|error|alert)$/]",
        "message": "<Notification> type must be one of 'hint' | 'info' | 'success' | 'warning' | 'error' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute[name.name='headingLevel'] > Literal[value!=/^(?:h2|h3|h4|h5)$/]",
        "message": "<Notification> headingLevel must be one of 'h2' | 'h3' | 'h4' | 'h5'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|placeholder|value|defaultValue|negative|large|onChange|onSubmit|className|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: id, label, placeholder, value, defaultValue, negative, large, onChange, onSubmit, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|negative|className|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation, negative, className."
